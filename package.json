{
  "name": "headsbase-ats",
  "version": "0.1.0",
  "private": true,
  "main": "desktop/dist/main.js",
  "scripts": {
    "dev": "next dev",
    "dev:lan": "cross-env HOSTNAME=0.0.0.0 NODE_ENV=development next dev -H 0.0.0.0",
    "prebuild": "tsx scripts/prebuild-unlock.ts",
    "build": "next build --webpack",
    "build:netlify": "prisma generate && next build",
    "postbuild": "tsx scripts/prepare-standalone.ts",
    "start": "tsx scripts/start-standalone.ts",
    "start:lan": "cross-env HOSTNAME=0.0.0.0 tsx scripts/start-standalone.ts",
    "lint": "eslint src desktop",
    "desktop:compile": "tsc -p desktop/tsconfig.json",
    "desktop:prepare": "tsx scripts/desktop-prepare.ts",
    "desktop:build": "npm run build && npm run desktop:prepare && npm run desktop:compile",
    "desktop:dev": "npm run desktop:compile && cross-env HEADSBASE_DESKTOP=1 HEADSBASE_DESKTOP_DEV=1 electron .",
    "package": "npm run desktop:build && electron-builder --win",
    "package:dir": "npm run desktop:build && electron-builder --win --dir",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "env:use-local-db": "tsx scripts/use-local-db.ts",
    "env:use-lan-url": "tsx scripts/env-use-lan-url.ts",
    "env:use-neon-db": "tsx scripts/use-neon-db.ts",
    "setup:local": "tsx scripts/setup-local.ts",
    "setup:lan": "tsx scripts/setup-lan.ts",
    "setup:db": "tsx scripts/setup-db.ts",
    "setup:db:demo": "tsx scripts/setup-db.ts --demo",
    "env:use-production": "tsx scripts/env-use-production.ts",
    "backup": "tsx scripts/backup-server.ts",
    "backup:list": "tsx scripts/restore-server.ts",
    "backup:restore": "tsx scripts/restore-server.ts",
    "repair:user-org": "tsx scripts/repair-user-org.ts",
    "admin:reset-password": "tsx scripts/admin-reset-password.ts",
    "verify:infra": "tsx scripts/verify-infra.ts",
    "test:smoke": "tsx scripts/smoke-test.ts",
    "test:resume-parser": "tsx scripts/test-resume-parser.ts",
    "test:boolean-search": "tsx scripts/test-boolean-search.ts",
    "test:boolean-integration": "tsx scripts/test-boolean-integration.ts",
    "test:matching-v2": "tsx scripts/test-matching-v2.ts",
    "test:matching-retrieval": "tsx scripts/test-matching-retrieval.ts",
    "db:apply-matching-v2": "tsx scripts/apply-matching-v2.ts",
    "test:search": "tsx scripts/test-search.ts",
    "test:enterprise-perf": "tsx scripts/smoke-enterprise-perf.ts",
    "test:rag-eval": "tsx scripts/test-rag-eval.ts",
    "db:enable-pgvector": "tsx scripts/enable-pgvector.ts",
    "rag:backfill": "tsx scripts/rag-backfill.ts",
    "env:sync-direct-url": "tsx scripts/sync-direct-url.ts",
    "db:apply-rls": "tsx scripts/apply-rls.ts",
    "reparse:candidates": "tsx scripts/reparse-candidates.ts",
    "cleanup:submitted-data": "tsx scripts/cleanup-submitted-data.ts",
    "cleanup:duplicate-resumes": "tsx scripts/cleanup-duplicate-resumes.ts",
    "catchup:supabase": "tsx scripts/catchup-supabase.ts",
    "storage:migrate-local-to-r2": "tsx scripts/migrate-local-to-r2.ts",
    "worker:match": "tsx scripts/match-worker.ts",
    "db:apply-enterprise-perf": "tsx scripts/apply-enterprise-perf.ts",
    "dedupe:emails": "tsx scripts/merge-duplicate-emails.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1104.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.7.1",
    "@prisma/client": "^6.19.0",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@swc/helpers": "^0.5.23",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.7.2",
    "bullmq": "^5.58.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "geist": "^1.7.2",
    "ioredis": "^5.8.2",
    "jszip": "^3.10.1",
    "lucide-react": "^1.28.0",
    "mammoth": "^1.12.0",
    "next": "16.3.0",
    "papaparse": "^5.5.4",
    "pdf-parse": "^2.4.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.84.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tesseract.js": "^7.0.0",
    "uuid": "^14.0.1",
    "word-extractor": "^1.0.4",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "cross-env": "^7.0.3",
    "dotenv": "^17.4.2",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "prisma": "^6.12.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.8",
    "typescript": "^5"
  },
  "build": {
    "appId": "com.headsbase.ats",
    "productName": "Headsbase ATS",
    "copyright": "Copyright © Headsbase",
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "desktop/dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "standalone",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/postgresql",
        "to": "postgresql",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "prisma",
        "to": "prisma",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/parser",
        "to": "parser",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/prisma-cli",
        "to": "prisma-cli",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false,
      "forceCodeSigning": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Headsbase ATS",
      "deleteAppDataOnUninstall": false
    },
    "asarUnpack": [
      "node_modules/.prisma/**",
      "node_modules/@prisma/**",
      "node_modules/prisma/**"
    ]
  }
}
