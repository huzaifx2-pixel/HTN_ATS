  @@unique([organizationId, identityKey])
  @@index([organizationId, stage])
  @@index([organizationId, matchingStatus])
  @@index([organizationId, csvStatus])
  @@index([organizationId, lastSeenInImportAt])
  @@index([candidateId])
}

