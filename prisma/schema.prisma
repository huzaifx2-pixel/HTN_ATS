  candidateId            String?
  candidate              Candidate?            @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  identityKey            String
  csvName                String
  normalizedName         String
  externalId             String?
  referrer               String?
  dateReferred           DateTime?
  projectType            String?
  csvStatus              String
  stage                  Micro1ReferralStage
  appliedAt              DateTime?
