  appliedStage  Micro1ReferralStage
  importBatchId String?
  importBatch   Micro1ReferralImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  createdAt     DateTime             @default(now())

  @@index([referralId, createdAt])
}

model Micro1ReferralImportBatch {
  id             String                  @id @default(cuid())
  organizationId String
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fileName       String
  fileHash       String
  status         Micro1ImportBatchStatus @default(RUNNING)
  totalRows      Int                     @default(0)
  validCount     Int                     @default(0)
  invalidCount   Int                     @default(0)
  matched        Int                     @default(0)
  unmatched      Int                     @default(0)
  needsReview    Int                     @default(0)
  statusChanges  Int                     @default(0)
  createdCount   Int                     @default(0)
  updatedCount   Int                     @default(0)
  duplicateRows  Int                     @default(0)
  resultJson     Json?
  errorMessage   String?
  uploadedById   String?
  uploadedBy     User?                   @relation("Micro1ImportUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt      DateTime                @default(now())

  referrals      Micro1Referral[]        @relation("Micro1ReferralLastBatch")
  statusEvents   Micro1ReferralStatusEvent[]

  @@index([organizationId, createdAt])
  @@index([organizationId, fileHash])
}

model Micro1NameLink {
  id             String     @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  normalizedName String
  candidateId    String
  candidate      Candidate  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  createdAt      DateTime   @default(now())

  @@unique([organizationId, normalizedName])
  @@index([candidateId])
}

model Micro1MatchAudit {
  id             String               @id @default(cuid())
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  referralId     String
  referral       Micro1Referral       @relation(fields: [referralId], references: [id], onDelete: Cascade)
  actorUserId    String?
  actor          User?                @relation("Micro1MatchActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  fromStatus     Micro1MatchingStatus
  toStatus       Micro1MatchingStatus
  candidateId    String?
  createdAt      DateTime             @default(now())

  @@index([referralId, createdAt])
  @@index([organizationId, createdAt])
}


