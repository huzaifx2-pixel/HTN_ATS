generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Better Auth ───────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions      Session[]
  accounts      Account[]
  members       Member[]
  invitations   Invitation[]

  ownedJobs     Job[]              @relation("JobOwner")
  jobNotes      JobNote[]          @relation("JobNoteAuthor")
  stageChanges  StageHistory[]
  sentMessages  Message[]
  channelMembers ChannelMember[]
  notifications Notification[]
  auditLogs     AuditLog[]
  gmailConnections GmailConnection[]
  outreachMailboxes OutreachMailbox[]
  micro1ImportBatches Micro1ReferralImportBatch[] @relation("Micro1ImportUploader")
  micro1ReferralLinks Micro1Referral[] @relation("Micro1ReferralLinkedBy")
  micro1MatchAudits Micro1MatchAudit[] @relation("Micro1MatchActor")
}

model Session {
  id                   String   @id @default(cuid())
  expiresAt            DateTime
  token                String   @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  issuer                String?
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logo      String?
  metadata  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members       Member[]
  invitations   Invitation[]
  clients       Client[]
  jobs          Job[]
  candidates    Candidate[]
  candidateDrafts CandidateDraft[]
  channels      Channel[]
  emailTemplates EmailTemplate[]
  referralTemplates ReferralTemplate[]
  marketingCampaigns MarketingCampaign[]
  marketingAudiences MarketingAudience[]
  marketingAudienceContacts MarketingAudienceContact[]
  marketingTemplates MarketingTemplate[]
  marketingBrandKit MarketingBrandKit?
  marketingMediaAssets MarketingMediaAsset[]
  marketingAutomations MarketingAutomation[]
  marketingSuppressions MarketingSuppression[]
  marketingSettings MarketingSettings?
  jobTemplates      JobTemplate[]
  savedViews        SavedView[]
  auditLogs     AuditLog[]
  orgSettings   OrgSettings?
  jobImportBatches JobImportBatch[]
  resumeImportBatches ResumeImportBatch[]
  linkedInJobMatches LinkedInJobMatch[]
  emailSendQueue EmailSendQueue[]
  outreachMailboxes OutreachMailbox[]
  knowledgeDocuments KnowledgeDocument[]
  candidateHotlists  CandidateHotlist[]
  crmContacts        CrmContact[]
  opportunities      Opportunity[]
  employers          Employer[]
  jobNotes           JobNote[]
  micro1Referrals    Micro1Referral[]
  micro1ReferralImportBatches Micro1ReferralImportBatch[]
  micro1NameLinks    Micro1NameLink[]
  micro1MatchAudits  Micro1MatchAudit[]
  roleFeatures       RoleFeature[]
}

model Member {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           MemberRole   @default(RECRUITER)
  createdAt      DateTime     @default(now())

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
}

model Invitation {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           MemberRole       @default(RECRUITER)
  status         InvitationStatus @default(PENDING)
  expiresAt      DateTime
  inviterId      String
  inviter        User             @relation(fields: [inviterId], references: [id], onDelete: Cascade)
  createdAt      DateTime         @default(now())

  @@index([organizationId])
}

model RoleFeature {
  id             String     @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           MemberRole
  feature        String
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([organizationId, role, feature])
  @@index([organizationId, role])
}

enum MemberRole {
  OWNER
  ADMIN
  MANAGER
  RECRUITER
  MARKETING
  FINANCE
  VIEWER
  EXTERNAL_RECRUITER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

// Canonical domain enums (aligned with htn-api Postgres schema)
enum OrganizationType {
  COMPANY
  CLIENT
  VENDOR
  MSP
  UNIVERSITY
  HOSPITAL
  PARTNER
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  TEMPORARY
  INTERNSHIP
  FREELANCE
  VOLUNTEER
}

enum WorkplaceType {
  ON_SITE
  REMOTE
  HYBRID
}

enum JobSource {
  MICRO1
  GREENHOUSE
  LEVER
  ASHBY
  WORKDAY
  LINKEDIN
  MANUAL
  CSV
  OTHER
}

enum JobImportBatchStatus {
  PREVIEW
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum CandidateStatus {
  NEW
  ACTIVE
  INTERVIEWING
  PLACED
  INACTIVE
  ARCHIVED
}

enum ApplicationSource {
  CAREERS_SITE
  RECRUITER
  REFERRAL
  IMPORT
  LINKEDIN
  OTHER
}

enum DocumentType {
  RESUME
  COVER_LETTER
  CERTIFICATION
  PORTFOLIO
  OTHER
}

model Client {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  prefix         String
  logoUrl        String?
  externalId     String?
  sourceVersion  String?
  type           OrganizationType?
  legalName      String?
  website        String?
  linkedinUrl    String?
  industry       String?
  description    String?
  headquarters   String?
  employeeCount  Int?
  foundedYear    Int?
  metadata       Json?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  jobs           Job[]
  candidates     Candidate[]
  documents      Document[]
  prefixRule     ClientPrefixRule?
  crmContacts    CrmContact[]
  opportunities  Opportunity[]

  @@unique([organizationId, prefix])
  @@index([organizationId])
  @@index([externalId])
  @@index([name])
}

model ClientPrefixRule {
  id         String @id @default(cuid())
  clientId   String @unique
  client     Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  lastNumber Int    @default(0)
}

enum JobStatus {
  OPEN
  ON_HOLD
  CLOSED
  FILLED
}

enum JobPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Job {
  id                      String           @id @default(cuid())
  organizationId          String
  organization            Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId                String
  client                  Client           @relation(fields: [clientId], references: [id])
  ownerId                 String?
  owner                   User?            @relation("JobOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  jobCode                 String
  externalId              String?
  sourceVersion           String?
  source                  JobSource?
  title                   String
  slug                    String?
  summary                 String?
  description             String?
  descriptionHtml         String?
  responsibilities        String?
  requirementsText        String?
  preferredQualifications String?
  benefits                String?
  employmentType          EmploymentType?
  workplaceType           WorkplaceType?
  department              String?
  jobFunction             String?
  seniority               String?
  priority                JobPriority      @default(MEDIUM)
  experienceMin           Int?
  experienceMax           Int?
  salaryMin               Decimal?
  salaryMax               Decimal?
  salaryCurrency          String?
  billRateMin             Decimal?
  billRateMax             Decimal?
  payRateMin              Decimal?
  payRateMax              Decimal?
  ratePeriod              String?
  location                String?
  country                 String?
  city                    String?
  state                   String?
  zip                     String?
  address1                String?
  address2                String?
  timezone                String?
  remote                  Boolean?
  referralLink            String?
  referralKey             String?
  applyUrl                String?
  canonicalUrl            String?
  requirements            Json?
  openings                Int              @default(1)
  maxSubmissions          Int?
  status                  JobStatus        @default(OPEN)
  startDate               DateTime?
  endDate                 DateTime?
  requireResume           Boolean          @default(true)
  travelRequired          Boolean          @default(false)
  otRequired              Boolean          @default(false)
  referencesRequired      Boolean          @default(false)
  drugTestRequired        Boolean          @default(false)
  backgroundCheckRequired Boolean          @default(false)
  securityClearanceRequired Boolean        @default(false)
  dedupeHash              String?
  importedAt              DateTime?
  csvManagedAt            DateTime?
  lastCsvImportBatchId    String?
  lastCsvImportBatch      JobImportBatch?  @relation("JobCsvImportBatch", fields: [lastCsvImportBatchId], references: [id], onDelete: SetNull)
  autoEmailEnabled        Boolean          @default(false)
  autoEmailTemplateId     String?
  autoEmailMinScore       Int              @default(70)
  postedAt                DateTime?
  closedAt                DateTime?
  expiresAt               DateTime?
  metadata                Json?
  structured              Json?
  parseMetadata           Json?
  parserVersion           String?
  booleanSearch           String?
  booleanSearchUpdatedAt  DateTime?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  applications            Application[]
  matches                 JobMatch[]
  linkedInMatches         LinkedInJobMatch[]
  documents               Document[]
  notes                   JobNote[]
  emailCampaigns          EmailCampaign[]
  channels                Channel[]
  activities              JobActivity[]
  jobSkills               JobSkill[]
  searchIndex             JobSearchIndex?

  @@unique([organizationId, jobCode])
  @@unique([organizationId, source, externalId])
  @@unique([organizationId, referralKey])
  @@index([organizationId, status])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, status, importedAt])
  @@index([organizationId, status, closedAt])
  @@index([organizationId, source])
  @@index([organizationId, source, status])
  @@index([externalId])
  @@index([clientId])
  @@index([dedupeHash])
  @@index([employmentType])
  @@index([workplaceType])
  @@index([postedAt])
  @@index([organizationId, updatedAt])
  @@index([organizationId, title])
  @@index([organizationId, location])
  @@index([lastCsvImportBatchId])
}

model JobImportBatch {
  id             String                @id @default(cuid())
  organizationId String
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fileName       String
  format         String
  status         JobImportBatchStatus  @default(COMPLETED)
  totalRows      Int                   @default(0)
  imported       Int                   @default(0)
  duplicates     Int                   @default(0)
  errors         Int                   @default(0)
  newCount       Int                   @default(0)
  updated        Int                   @default(0)
  reopened       Int                   @default(0)
  willClose      Int                   @default(0)
  closed         Int                   @default(0)
  unchanged      Int                   @default(0)
  conflict       Int                   @default(0)
  invalid        Int                   @default(0)
  duplicateRows  Int                   @default(0)
  created        Int                   @default(0)
  previewJson    Json?
  resultJson     Json?
  uploadedById   String?
  confirmedAt    DateTime?
  startedAt      DateTime?
  errorMessage   String?
  createdAt      DateTime              @default(now())

  csvManagedJobs Job[]                 @relation("JobCsvImportBatch")

  @@index([organizationId, createdAt])
  @@index([organizationId, status])
}

enum ResumeImportStatus {
  SUCCESS
  FAILED
  DUPLICATE
  SKIPPED
}

model ResumeImportBatch {
  id             String             @id @default(cuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  candidateId    String?
  candidate      Candidate?         @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  fileName       String
  fileHash       String?
  source         CandidateSource
  status         ResumeImportStatus
  parseError     String?
  durationMs     Int?
  duplicateOfId  String?
  metadata       Json?
  createdAt      DateTime           @default(now())

  @@index([organizationId, createdAt])
  @@index([candidateId])
  @@index([fileHash])
}

enum EmailQueueStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

model EmailSendQueue {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobId          String
  candidateId    String
  templateId     String?
  senderUserId   String?
  outreachMailboxId String?
  outreachMailbox OutreachMailbox? @relation(fields: [outreachMailboxId], references: [id], onDelete: SetNull)
  subject        String?
  body           String?
  customLink     String?
  status         EmailQueueStatus @default(PENDING)
  retryCount     Int              @default(0)
  maxRetries     Int              @default(3)
  nextRetryAt    DateTime         @default(now())
  lastError      String?
  autoSent       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([status, nextRetryAt])
  @@index([organizationId])
  @@index([jobId, candidateId])
  @@index([outreachMailboxId])
}

model JobActivity {
  id        String   @id @default(cuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  actorId   String?
  action    String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([jobId, createdAt])
}

model JobNote {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobId          String
  job            Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  authorId       String?
  author         User?        @relation("JobNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  body           String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([jobId, createdAt])
  @@index([organizationId])
}

enum CandidateSource {
  MANUAL
  UPLOAD
  BULK_UPLOAD
  GMAIL
  IMPORT
  REFERRAL
  LINKEDIN
}

enum DraftStatus {
  PENDING
  APPROVED
  REJECTED
}

model Candidate {
  id                String          @id @default(cuid())
  organizationId    String
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  externalId        String?
  sourceVersion     String?
  status            CandidateStatus @default(NEW)
  firstName         String
  lastName          String
  headline          String?
  email             String?
  altEmail          String?
  phone             String?
  phoneCountryCode  String?
  altPhone          String?
  altPhoneCountryCode String?
  linkedIn          String?
  normalizedEmail   String?
  normalizedPhone   String?
  normalizedLinkedIn String?
  resumeFingerprint String?
  githubUrl         String?
  portfolioUrl      String?
  website           String?
  currentCompany    String?
  currentRole       String?
  currentTitle      String?
  location          String?
  country           String?
  city              String?
  skills            Json?
  experienceYears   Float?
  yearsExperience   Int?
  workAuthorization String?
  availability      String?
  desiredSalary     Decimal?
  noticePeriod      Int?
  summary           String?
  source            CandidateSource @default(MANUAL)
  currentClientId   String?
  currentClient     Client?         @relation(fields: [currentClientId], references: [id], onDelete: SetNull)
  currentEmployerId String?
  currentEmployer   Employer?       @relation("CandidateCurrentEmployer", fields: [currentEmployerId], references: [id], onDelete: SetNull)
  dedupeHash        String?
  engagedAt         DateTime?
  doNotContact      Boolean         @default(false)
  doNotContactAt    DateTime?
  metadata          Json?
  deletedAt         DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  applications      Application[]
  matches           JobMatch[]
  linkedInImports   LinkedInJobMatch[]
  documents         Document[]
  parsedResume      ParsedResume?
  activities        CandidateActivity[]
  drafts            CandidateDraft[]
  candidateSkills   CandidateSkill[]
  resumeImportBatches ResumeImportBatch[]
  hotlistMembers    CandidateHotlistMember[]
  experiences       CandidateExperience[]
  educations        CandidateEducation[]
  candidateCerts    CandidateCertification[]
  searchIndex       CandidateSearchIndex?
  micro1Referrals   Micro1Referral[]
  micro1NameLinks   Micro1NameLink[]
  suggestedForReferrals Micro1Referral[] @relation("Micro1SuggestedCandidate")

  @@index([organizationId])
  @@index([organizationId, createdAt])
  @@index([organizationId, deletedAt, createdAt])
  @@index([organizationId, email])
  @@index([organizationId, engagedAt])
  @@index([organizationId, status])
  @@index([organizationId, firstName])
  @@index([organizationId, lastName])
  @@index([organizationId, location])
  @@index([currentClientId])
  @@index([currentEmployerId])
  @@index([externalId])
  @@index([dedupeHash])
  @@index([deletedAt])
  @@index([linkedIn])
  @@index([updatedAt])
  @@index([organizationId, normalizedEmail])
  @@index([organizationId, normalizedPhone])
  @@index([organizationId, normalizedLinkedIn])
  @@index([organizationId, resumeFingerprint])
}

model CandidateDraft {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  gmailMessageId    String?
  gmailAttachmentId String?
  fileName          String?
  candidateId       String?
  candidate         Candidate?   @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  status            DraftStatus  @default(PENDING)
  firstName         String?
  lastName          String?
  email             String?
  phone             String?
  parsedData        Json?
  suggestedJobs     Json?
  storageKey        String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@unique([organizationId, gmailMessageId, gmailAttachmentId])
  @@index([organizationId, status])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, gmailMessageId])
}

model ParsedResume {
  id             String   @id @default(cuid())
  candidateId    String   @unique
  candidate      Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  rawText        String?
  skills         Json?
  experience     Json?
  education      Json?
  certifications Json?
  structured     Json?
  parseMetadata  Json?
  parserVersion  String?
  summary        String?
  projects       Json?
  parsedAt       DateTime @default(now())
}

model Employer {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  normalizedName String
  website        String?
  linkedIn       String?
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  candidates     Candidate[]           @relation("CandidateCurrentEmployer")
  experiences    CandidateExperience[]

  @@unique([organizationId, normalizedName])
  @@index([organizationId])
}

model CandidateExperience {
  id               String    @id @default(cuid())
  candidateId      String
  candidate        Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  employerId       String?
  employer         Employer? @relation(fields: [employerId], references: [id], onDelete: SetNull)
  company          String
  title            String
  location         String?
  startDate        DateTime?
  endDate          DateTime?
  isCurrent        Boolean   @default(false)
  durationMonths   Int?
  confidence       Float?
  reviewStatus     String?
  extractionMethod String?
  source           String?
  responsibilities Json?
  metadata         Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([candidateId])
  @@index([employerId])
}

model CandidateEducation {
  id               String    @id @default(cuid())
  candidateId      String
  candidate        Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  institution      String
  degree           String?
  field            String?
  honors           String?
  graduationDate   String?
  confidence       Float?
  reviewStatus     String?
  extractionMethod String?
  source           String?
  metadata         Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([candidateId])
}

model CandidateCertification {
  id               String    @id @default(cuid())
  candidateId      String
  candidate        Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  name             String
  issuer           String?
  issueDate        String?
  expiryDate       String?
  credentialId     String?
  status           String?
  confidence       Float?
  reviewStatus     String?
  extractionMethod String?
  source           String?
  metadata         Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([candidateId])
}

model CandidateActivity {
  id          String    @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  action      String
  metadata    Json?
  createdAt   DateTime  @default(now())

  @@index([candidateId, createdAt])
}

model Document {
  id              String       @id @default(cuid())
  organizationId  String?
  jobId           String?
  job             Job?         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidateId     String?
  candidate       Candidate?   @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  clientId        String?
  client          Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type            DocumentType @default(OTHER)
  storageProvider String?
  storageKey      String
  fileName        String
  mimeType        String
  sizeBytes       Int          @default(0)
  checksum        String?
  version         Int          @default(1)
  isLatest        Boolean      @default(true)
  uploadedBy      String?
  metadata        Json?
  parsedAt        DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @default(now()) @updatedAt

  @@index([jobId])
  @@index([candidateId])
  @@index([organizationId])
  @@index([clientId])
  @@index([type])
}

enum PipelineStage {
  NOT_APPLIED
  APPLYING
  INTERVIEW_COMPLETED
  MCC
  CERTIFIED
  MATCHED_TO_PROJECT
  PLACEMENT
}

model Application {
  id                String             @id @default(cuid())
  externalId        String?
  sourceVersion     String?
  jobId             String
  job               Job                @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidateId       String
  candidate         Candidate          @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  stage             PipelineStage      @default(NOT_APPLIED)
  source            ApplicationSource?
  coverLetter       String?
  additionalNotes   String?
  salaryExpectation Decimal?
  noticePeriod      Int?
  submittedAt       DateTime?
  metadata          Json?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  stageHistory      StageHistory[]

  @@unique([jobId, candidateId])
  @@index([jobId, stage])
  @@index([candidateId])
  @@index([updatedAt])
}

model StageHistory {
  id            String        @id @default(cuid())
  applicationId String
  application   Application   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fromStage     PipelineStage?
  toStage       PipelineStage
  changedById   String?
  changedBy     User?         @relation(fields: [changedById], references: [id], onDelete: SetNull)
  note          String?
  changedAt     DateTime      @default(now())

  @@index([applicationId, changedAt])
}

model LinkedInJobMatch {
  id                  String    @id @default(cuid())
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobId               String
  job                 Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  linkedInUrl         String
  linkedInSlug        String
  fullName            String
  headline            String?
  currentTitle        String?
