# Local PostgreSQL (Docker) — default for development
# Runtime Prisma uses DATABASE_URL (pooled). DIRECT_URL is for migrations only.
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/headsbase_ats"
DIRECT_URL="postgresql://postgres:postgres@localhost:5434/headsbase_ats"

# Hosted Postgres: DATABASE_URL should be the pooler (PgBouncer / Neon pooler / Supabase 6543).
# DIRECT_URL should be the session/direct port (5432) for migrations.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=5"
# DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require"

BETTER_AUTH_SECRET="change-me-to-a-random-32-char-secret"
BETTER_AUTH_URL="http://localhost:3000"

# Production LAN server — durable paths (set by npm run env:use-production)
# HEADSBASE_DATA_DIR="./data"
# STORAGE_LOCAL_PATH="./data/uploads"

# Gmail integration — required for Resume Inbox sync + sending from your email
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# LinkedIn Matches (Google Programmable Search / X-Ray). Do not scrape LinkedIn HTML.
# Create a Programmable Search Engine and enable the Custom Search JSON API.
GOOGLE_CSE_API_KEY=""
GOOGLE_CSE_ID=""

# ─── File storage (resumes, attachments) ───
STORAGE_PROVIDER="local"
STORAGE_LOCAL_PATH="./uploads"

# Cloudflare R2 (optional production storage)
R2_ACCOUNT_ID=""
R2_ENDPOINT=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="headsbase-ats"

RESUME_PARSER_PROVIDER="local"

WEBSITE_JOB_SYNC_ENABLED="true"
HEADSBASE_JOBS_API_URL="https://htn-api-production-ab6d.up.railway.app/api/jobs"

# Single-org LAN deployment (all users share Headsbase Consulting)
HEADSBASE_SINGLE_ORG="true"
HEADSBASE_ORG_NAME="Headsbase Consulting"
HEADSBASE_ORG_SLUG="headsbase-consulting"

GMAIL_SYNC_ENABLED="true"

# Redis (BullMQ match worker + cache). docker compose includes redis on 6379.
REDIS_URL="redis://localhost:6379"

TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
TELEGRAM_NOTIFICATIONS_ENABLED="false"

# ─── RAG (pgvector + OpenAI-compatible embeddings/chat) ───
# Indexer cannot write vectors until OPENAI_API_KEY (or RAG_API_KEY) is set.
RAG_ENABLED="true"
OPENAI_API_KEY=""
RAG_API_BASE_URL="https://api.openai.com/v1"
RAG_EMBEDDING_MODEL="text-embedding-3-small"
RAG_EMBEDDING_DIMENSIONS="1536"
RAG_GENERATION_MODEL="gpt-4o-mini"
# full = embed resume raw text; summary = name/skills/headline only (less PII)
RAG_PII_MODE="full"
RAG_MONTHLY_BUDGET_USD="20"
RAG_TOP_K="8"
RAG_MIN_SIMILARITY="0.25"
RAG_SEMANTIC_MATCH_WEIGHT="0.15"
