# Neon PostgreSQL (free Supabase alternative — no Docker required)
# Get URLs from https://console.neon.tech → your project → Connect

# Pooled connection (app runtime)
NEON_DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Direct connection (migrations, seeds)
NEON_DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# RAG uses DIRECT_URL for CREATE EXTENSION vector
# OPENAI_API_KEY=""
# RAG_EMBEDDING_MODEL="text-embedding-3-small"
# RAG_EMBEDDING_DIMENSIONS="1536"
# RAG_GENERATION_MODEL="gpt-4o-mini"
