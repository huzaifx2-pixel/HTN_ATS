# Supabase + R2 production environment
# Copy to .env and fill in secrets from your dashboards.

# Supabase Postgres (Project: vxfgbkriwphzleggectt, region: ap-south-1)
# Dashboard → Project Settings → Database → Connection string → URI (Transaction pooler)
DATABASE_URL="postgresql://postgres.vxfgbkriwphzleggectt:[YOUR-DB-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

BETTER_AUTH_SECRET="change-me-to-a-random-32-char-secret"
BETTER_AUTH_URL="http://localhost:3000"

# Cloudflare R2 file storage
STORAGE_PROVIDER="r2"
R2_ACCOUNT_ID="df161f6a44f7a66be880ee139e6e418c"
R2_ENDPOINT="https://df161f6a44f7a66be880ee139e6e418c.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="headsbase-ats"

# Gmail (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

RESUME_PARSER_PROVIDER="local"
WEBSITE_JOB_SYNC_ENABLED="true"
HEADSBASE_JOBS_API_URL="https://htn-api-production-ab6d.up.railway.app/api/jobs"

# RAG / Ask ATS (enable pgvector on DIRECT_URL, then set a key)
RAG_ENABLED="true"
OPENAI_API_KEY=""
RAG_API_BASE_URL="https://api.openai.com/v1"
RAG_EMBEDDING_MODEL="text-embedding-3-small"
RAG_EMBEDDING_DIMENSIONS="1536"
RAG_GENERATION_MODEL="gpt-4o-mini"
RAG_PII_MODE="full"
RAG_MONTHLY_BUDGET_USD="20"
